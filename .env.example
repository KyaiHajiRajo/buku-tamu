# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=buku_tamu
DB_PORT=3306

# Server
PORT=1000
# development | production (production: cache view & static, error detail disembunyikan)
NODE_ENV=production

# Wajib diisi string acak minimal 32 karakter, contoh hasil:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# true jika situs diakses lewat HTTPS
COOKIE_SECURE=false
# Isi 1 jika berjalan di belakang reverse proxy (nginx / cloudflare)
TRUST_PROXY=

# false untuk mematikan notifikasi WhatsApp (hemat RAM, tanpa Chrome)
WHATSAPP_ENABLED=true
# Maksimal submit form per menit per IP
SUBMIT_RATE_LIMIT=30
